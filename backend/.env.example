# Copy to backend/.env and fill in your key.

# Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Default model (overridable per request from the UI)
GROQ_MODEL=openai/gpt-oss-120b

# Where SQLite, Chroma and uploads live.
# Local default is backend/data. On Render set this to the mounted disk path.
# DATA_DIR=/var/data

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4
# Chunks scoring below this cosine similarity are discarded rather than shown
# as "sources". Raise it for stricter grounding, lower it if relevant passages
# are being dropped.
MIN_SIMILARITY=0.25
MAX_UPLOAD_MB=20

# Comma-separated allowed origins, or * for all
CORS_ORIGINS=*
